<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_border_rounded"
    android:backgroundTint="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAdminWProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vợt cầu lông Yonex"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvAdminWStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Chờ xử lý"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_rounded" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- User + Order -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Khách hàng"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAdminWUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mã đơn hàng"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAdminWOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#ABCD1234"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ngày mua"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAdminWPurchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/05/2026"
            android:textColor="#333333"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hết hạn BH"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvAdminWExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/05/2027"
            android:textColor="#E64A19"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Claim note -->
    <LinearLayout
        android:id="@+id/layoutAdminWClaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF8E1"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả lỗi từ khách:"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAdminWClaimNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#555555"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Admin note -->
    <LinearLayout
        android:id="@+id/layoutAdminWNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8F5E9"
        android:padding="10dp"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phản hồi của bạn:"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAdminWNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#2E7D32"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Respond button (only for "Chờ xử lý") -->
    <Button
        android:id="@+id/btnRespondWarranty"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1565C0"
        android:text="Phản hồi &amp; xử lý"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>

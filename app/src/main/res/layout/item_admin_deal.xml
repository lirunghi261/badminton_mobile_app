<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_login_card"
    android:elevation="2dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Discount badge -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#FBE9E7"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDealDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-20%"
            android:textColor="#E64A19"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvDealCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUMMER20"
                android:textColor="#333333"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvDealStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_deal_active"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Đang hoạt động"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDealDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/05/2026 → 31/05/2026"
            android:textColor="#888888"
            android:textSize="12sp"
            android:drawableStart="@drawable/ic_notification"
            android:drawablePadding="4dp" />

        <TextView
            android:id="@+id/tvDealUsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Đã dùng: 0 lần"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Edit button -->
    <ImageView
        android:id="@+id/btnEditDeal"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_edit"
        app:tint="#1565C0"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        android:layout_marginEnd="4dp" />

    <!-- Delete button -->
    <ImageView
        android:id="@+id/btnDeleteDeal"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_delete"
        app:tint="#C62828"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_border_rounded"
    android:backgroundTint="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    android:padding="16dp">

    <!-- Header: product name + status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvWarrantyProduct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vợt cầu lông Yonex"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvWarrantyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Đang bảo hành"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_rounded" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Order ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mã đơn hàng"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvWarrantyOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#ABCD1234"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Purchase date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ngày mua"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvWarrantyPurchaseDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/05/2026"
            android:textColor="#333333"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Expiry date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hết hạn bảo hành"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvWarrantyExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/05/2027"
            android:textColor="#E64A19"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Claim note (hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutClaimNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF8E1"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả lỗi:"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvClaimNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#555555"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Admin note (hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutAdminNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8F5E9"
        android:padding="10dp"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phản hồi từ cửa hàng:"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAdminNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#2E7D32"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action button -->
    <Button
        android:id="@+id/btnWarrantyClaim"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#E64A19"
        android:text="Gửi yêu cầu bảo hành"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>

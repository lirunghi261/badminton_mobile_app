<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarAdminWarranty"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#E64A19"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/btnBackAdminWarranty"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="#FFFFFF"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quản lý bảo hành"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/tvWarrantyCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 yêu cầu"
            android:textColor="#FFFFFFCC"
            android:textSize="13sp"
            android:layout_marginEnd="12dp" />
    </LinearLayout>

    <!-- Search + Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:padding="12dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edtSearchWarranty"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_search_bar"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="Tìm tên sản phẩm, mã đơn hàng..."
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/awChipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Tất cả"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_rounded"
                    android:backgroundTint="#E64A19"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/awChipActive"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Đang bảo hành"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/awChipClaim"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Chờ xử lý"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/awChipDone"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Đã xử lý"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/awChipExpired"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="Hết hạn"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:background="@drawable/bg_search_bar"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminWarranty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp" />

    <!-- Empty -->
    <LinearLayout
        android:id="@+id/layoutAdminWarrantyEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không có yêu cầu bảo hành nào"
            android:textColor="#999999"
            android:textSize="16sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressAdminWarranty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>

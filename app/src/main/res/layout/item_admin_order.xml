<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_login_card"
    android:elevation="2dp"
    android:padding="16dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp">

    <!-- Row 1: Order ID + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAdminOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đơn: #ABCD1234"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="Chờ xác nhận"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#E64A19" />
    </LinearLayout>

    <!-- Row 2: Date -->
    <TextView
        android:id="@+id/tvAdminOrderDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="20/05/2026 14:00"
        android:textColor="#999999"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#EEEEEE" />

    <!-- Row 3: Items Preview -->
    <TextView
        android:id="@+id/tvAdminOrderItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vợt cầu lông Yonex x1, Giày Yonex x2..."
        android:textColor="#666666"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Row 4: Address -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_location"
            app:tint="#999999"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tvAdminOrderAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="123 Đường ABC"
            android:textColor="#999999"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Row 5: Payment Method -->
    <TextView
        android:id="@+id/tvAdminOrderPayment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Thanh toán khi nhận hàng"
        android:textColor="#999999"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#EEEEEE" />

    <!-- Row 6: Total + Update Status Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng tiền"
                android:textColor="#999999"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAdminOrderTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="đ1.500.000"
                android:textColor="#E64A19"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUpdateStatus"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cập nhật"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#1565C0"
            android:paddingHorizontal="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>
</LinearLayout>

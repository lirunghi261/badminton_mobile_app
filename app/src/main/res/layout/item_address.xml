<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvAddressLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Địa chỉ..."
        android:textColor="#333333"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/imgCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_checkbox_checked"
        android:visibility="invisible" />

    <ImageButton
        android:id="@+id/btnEditAddress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Sửa địa chỉ"
        android:padding="8dp"
        android:src="@drawable/ic_edit" />

    <ImageButton
        android:id="@+id/btnDeleteAddress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xoá địa chỉ"
        android:padding="8dp"
        android:src="@drawable/ic_delete" />

</LinearLayout>
